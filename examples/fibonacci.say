-- fibonacci.say — Generate the Fibonacci sequence
set a to 0
set b to 1
set fibs to list a, b

repeat 13 times
  set temp to a + b
  set a to b
  set b to temp
  add b to fibs
end

show Fibonacci sequence:
for each n in fibs
  show .n
end

show Sum: (.fibs.sum)
show Count: (.fibs.count)
show Max: (.fibs.max)
